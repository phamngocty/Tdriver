<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomSheetContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    app:behavior_hideable="false"
    app:behavior_peekHeight="220dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navigationBottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#D9131B2E"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:strokeColor="#3338BDF8"
        app:strokeWidth="1.2dp">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollBottomSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="#33FFFFFF" />

            <!-- 1. Place Info State (Search Result) -->
            <LinearLayout
                android:id="@+id/layoutPlaceInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tvPlaceName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Place Name"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPlaceAddress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Address"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnDirections"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="@string/directions"
                        android:textColor="@color/colorAccentCyan"
                        app:icon="@drawable/ic_directions"
                        app:iconTint="@color/colorAccentCyan"
                        app:strokeColor="@color/colorAccentCyan" />

                    <Button
                        android:id="@+id/btnStart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:backgroundTint="@color/colorAccentCyan"
                        android:text="@string/start"
                        android:textColor="@android:color/white"
                        app:icon="@drawable/ic_play"
                        app:iconTint="@android:color/white" />

                    <ImageButton
                        android:id="@+id/btnSavePlace"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_circle_button"
                        android:src="@drawable/ic_favorite"
                        app:tint="@color/speed_amber"
                        android:contentDescription="Lưu địa điểm" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. Route Preview State (Google Maps Style) -->
            <LinearLayout
                android:id="@+id/layoutRoutePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Header: Top bar with Title and Close button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvDestinationTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tuyến đường"
                        android:textColor="@android:color/white"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <ImageButton
                        android:id="@+id/btnOptions"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_circle_button"
                        android:src="@drawable/ic_settings"
                        app:tint="#CBD5E1"
                        android:padding="8dp" />

                    <ImageButton
                        android:id="@+id/btnClosePreview"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_circle_button"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        app:tint="#FFFFFF"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:elevation="4dp" />
                </LinearLayout>

                <!-- Vehicle Selector Tabs (Car / Scooter / Public / Walk) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:id="@+id/layoutVehicleTabs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Tab 1: Scooter (Xe máy - Default Selected) -->
                        <LinearLayout
                            android:id="@+id/tabScooter"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:paddingHorizontal="14dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_tab_selected"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:id="@+id/ivTabScooterIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_scooter"
                                app:tint="@color/colorAccentCyan" />
                            <TextView
                                android:id="@+id/tvTabScooterText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="5 phút"
                                android:textColor="@color/colorAccentCyan"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Tab 2: Car (Ô tô) -->
                        <LinearLayout
                            android:id="@+id/tabCar"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:paddingHorizontal="14dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_tab_unselected"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:id="@+id/ivTabCarIcon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_car"
                                app:tint="#94A3B8" />
                            <TextView
                                android:id="@+id/tvTabCarText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="-- phút"
                                android:textColor="#94A3B8"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Tab 3: Routes (Các tuyến đường) -->
                        <LinearLayout
                            android:id="@+id/tabRoutes"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:paddingHorizontal="14dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_tab_unselected"
                            android:clickable="true"
                            android:focusable="true">
                            <ImageView
                                android:id="@+id/ivTabRoutesIcon"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_directions"
                                app:tint="#94A3B8" />
                            <TextView
                                android:id="@+id/tvTabRoutesText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Các tuyến đường"
                                android:textColor="#94A3B8"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Tab 3: Transit -->
                        <LinearLayout
                            android:id="@+id/tabTransit"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:paddingHorizontal="14dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_tab_unselected">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_clock"
                                app:tint="#94A3B8" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="25 phút"
                                android:textColor="#94A3B8"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Tab 4: Walk -->
                        <LinearLayout
                            android:id="@+id/tabWalk"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"
                            android:paddingHorizontal="14dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:background="@drawable/bg_tab_unselected">
                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_my_location"
                                app:tint="#94A3B8" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="35 phút"
                                android:textColor="#94A3B8"
                                android:textSize="13sp" />
                        </LinearLayout>

                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Route Main Time & Distance Header -->
                <TextView
                    android:id="@+id/tvMainDurationDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 phút (1,8 km)"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Traffic & Description -->
                <TextView
                    android:id="@+id/tvRouteDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tuyến đường nhanh nhất từ Server NAS dựa trên tình trạng giao thông hiện tại"
                    android:textColor="#94A3B8"
                    android:textSize="13sp" />

                <!-- Eco & Parking Sub-info Badge Line -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_status_dot"
                        app:tint="#22C55E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Tiết kiệm 5% nhiên liệu"
                        android:textColor="#22C55E"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="6dp"
                        android:text="•"
                        android:textColor="#64748B" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🅿️ Dễ đỗ xe"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Action Button Row: [Bắt đầu] [Bước rẽ] (Prominent Upper Position) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Big Start Navigation Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartFromPreview"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1.6"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="@color/colorAccentCyan"
                        android:text="Bắt đầu"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/white"
                        app:cornerRadius="25dp"
                        app:icon="@drawable/ic_play"
                        app:iconTint="@android:color/white" />

                    <!-- Show Steps / Chi tiết bước rẽ Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnShowStepsPreview"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1.0"
                        android:backgroundTint="#1E293B"
                        android:text="Bước rẽ"
                        android:textSize="14sp"
                        android:textColor="#E2E8F0"
                        app:cornerRadius="25dp"
                        app:icon="@drawable/ic_directions"
                        app:iconTint="#94A3B8" />

                </LinearLayout>

                <!-- Alternatives Route List Header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="CÁC TUYẾN ĐƯỜNG GỢI Ý (ƯU TIÊN NAS)"
                    android:textColor="@color/colorAccentCyan"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAlternatives"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false"
                    android:visibility="visible" />

                <!-- Custom Weighting Options (Avoid Tolls / Ferries) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <CheckBox
                        android:id="@+id/cbAvoidTolls"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Né trạm thu phí"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp"
                        android:buttonTint="@color/colorAccentCyan" />

                    <CheckBox
                        android:id="@+id/cbAvoidFerries"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Né phà / đò"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp"
                        android:buttonTint="@color/colorAccentCyan" />
                </LinearLayout>

                <!-- Detailed Weather ETA Card (3 checkpoints: Start, ETA, ETA+1h matching NAS Dashboard) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardWeatherEta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="#0D1527"
                    app:cardCornerRadius="14dp"
                    app:strokeColor="#1E293B"
                    app:strokeWidth="1.2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <!-- Header Row: Title & ETA badge -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvWeatherEtaTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🕒 CHI TIẾT TUYẾN &amp; DỰ BÁO MƯA (ETA)"
                                android:textColor="@color/colorAccentCyan"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvWeatherEtaBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ETA: --:-- (+--m)"
                                android:textColor="#FDE047"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Step 1 Instruction preview -->
                        <TextView
                            android:id="@+id/tvWeatherFirstStep"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="📍 Bước 1: Tiếp tục"
                            android:textColor="#CBD5E1"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="8dp"
                            android:background="#1E293B" />

                        <!-- Row 1: Start Time Weather -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="3dp">

                            <TextView
                                android:id="@+id/tvWeatherStartLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🚩 Hiện tại xuất phát (--:--): ☀️ 28°C"
                                android:textColor="#E2E8F0"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvWeatherStartStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_circle_button"
                                android:backgroundTint="#064E3B"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="Tạnh ráo"
                                android:textColor="#34D399"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Row 2: ETA Time Weather (Highlighted) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:background="#162032"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="6dp">

                            <TextView
                                android:id="@+id/tvWeatherEtaLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="🏁 Khi đến nơi (--:--): 🌦️ 28°C"
                                android:textColor="#38BDF8"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvWeatherEtaStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_circle_button"
                                android:backgroundTint="#064E3B"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="Tạnh ráo"
                                android:textColor="#34D399"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Row 3: ETA + 1 Hour Weather -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingVertical="3dp">

                            <TextView
                                android:id="@+id/tvWeatherEtaPlus1Label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="⏳ 1 Giờ sau đó (--:--): ⛅ 27°C"
                                android:textColor="#94A3B8"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvWeatherEtaPlus1Status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_circle_button"
                                android:backgroundTint="#064E3B"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="2dp"
                                android:text="Tạnh ráo"
                                android:textColor="#34D399"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- 3. Navigation State (Active) -->
            <LinearLayout
                android:id="@+id/layoutNavigation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivNavIcon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_directions"
                        app:tint="@color/colorAccentCyan" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvNavInstruction"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@android:color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvNavDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@color/colorAccentCyan"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnRouteInfo"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_directions"
                        app:tint="@color/colorAccentCyan" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="#1FFFFFFF" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvNavEta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="--"
                        android:textColor="#10B981"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvNavWeather"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_circle_button"
                        android:backgroundTint="#162032"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="☀️ 28°C"
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnEndNav"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="#EF4444"
                        android:text="@string/end"
                        android:textColor="@android:color/white"
                        app:icon="@drawable/ic_stop"
                        app:iconTint="@android:color/white" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
