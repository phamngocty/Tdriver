<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:descendantFocusability="blocksDescendants"
    android:background="@color/colorBackgroundDeep">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="96dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bộ kết xuất (Render Debug)"
            android:textColor="@color/colorAccentCyan"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- Simulator Display Selector (Chọn chế độ Màn tròn S3 vs OLED C3) -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleSimulatorMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimWatch"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Màn tròn (240x240)"
                android:textSize="12sp"
                android:textColor="#F1F5F9"
                app:icon="@drawable/ic_clock"
                app:iconSize="16dp"
                app:iconTint="#38BDF8" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimOled"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OLED 2:1 (128x64)"
                android:textSize="12sp"
                android:textColor="#F1F5F9"
                app:icon="@drawable/ic_navigation_arrow"
                app:iconSize="16dp"
                app:iconTint="#38BDF8" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Display Layout Row for two views (Watch Round Display Simulator OR OLED 128x64 Simulator) -->
        <LinearLayout
            android:id="@+id/layoutWatchDisplayRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:baselineAligned="false">

            <!-- 1. Left View: Device Display Simulator (Watch Round 240x240 OR OLED 128x64 2:1) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvLeftMapTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Màn hình OLED 128x64 (ESP32-C3)"
                        android:textColor="@color/colorAccentCyan"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <!-- 1A. Circular Watch Simulator (240x240) - Hiện khi chọn Màn tròn -->
                    <FrameLayout
                        android:id="@+id/layoutLeftMapFrame"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:background="@drawable/bg_watch_frame"
                        android:padding="3dp"
                        android:visibility="gone">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cvLeftMapRoundCard"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="70dp"
                            app:cardBackgroundColor="#000000"
                            app:cardElevation="0dp">

                            <FrameLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent">

                                <!-- Map Image Preview -->
                                <ImageView
                                    android:id="@+id/ivMapPreview"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:contentDescription="Map Preview" />

                                <!-- Overlay Turn Icon Simulator -->
                                <ImageView
                                    android:id="@+id/ivIconPreview"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_gravity="center"
                                    android:scaleType="fitCenter"
                                    android:contentDescription="Turn Icon Preview" />

                            </FrameLayout>
                        </androidx.cardview.widget.CardView>
                    </FrameLayout>

                    <!-- 1B. Dedicated OLED 128x64 Simulator Frame (2:1 Ratio) - Hiện khi chọn OLED -->
                    <FrameLayout
                        android:id="@+id/layoutLeftOledFrame"
                        android:layout_width="140dp"
                        android:layout_height="70dp"
                        android:background="@drawable/bg_watch_frame"
                        android:padding="3dp"
                        android:visibility="visible">

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cvLeftOledCard"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="6dp"
                            app:cardBackgroundColor="#000000"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/ivOledMainPreview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitXY"
                                android:contentDescription="OLED 2:1 Screen Preview" />

                            <TextView
                                android:id="@+id/tvOledWaitingPlaceholder"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="Đang kết xuất OLED..."
                                android:textColor="#64748B"
                                android:textSize="9sp"
                                android:visibility="gone" />

                        </androidx.cardview.widget.CardView>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvOledStatusDetail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Trạng thái: Sẵn sàng"
                        android:textColor="@color/colorAccentCyan"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Right View: Full Rolling Map / Source Viewport Simulation -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvRollingMapTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bản đồ gốc (Base Map)"
                        android:textColor="#AAAAAA"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp"/>

                    <!-- Rolling Viewport (S3 Round Display) -->
                    <com.example.tymap.ui.CropPreviewImageView
                        android:id="@+id/ivFullMapPreview"
                        android:layout_width="110dp"
                        android:layout_height="183dp"
                        android:background="#000000"
                        android:scaleType="fitXY"
                        android:visibility="gone"
                        android:contentDescription="Full Map Preview" />

                    <!-- OLED 128x64 Horizontal Display Module / Base Map Simulation (ESP32-C3) -->
                    <FrameLayout
                        android:id="@+id/layoutOledFrame"
                        android:layout_width="140dp"
                        android:layout_height="70dp"
                        android:background="@drawable/bg_glass_card"
                        android:padding="3dp"
                        android:visibility="visible">

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            app:cardCornerRadius="6dp"
                            app:cardBackgroundColor="#000000"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/ivOledPreview"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="fitXY"
                                android:contentDescription="OLED Base Map Preview" />

                        </androidx.cardview.widget.CardView>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvRollingMapDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Nguồn thu nhận / Bản đồ gốc"
                        android:textColor="@color/colorTextMuted"
                        android:textSize="10sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- Card Điều khiển Chế độ Mô phỏng OLED (Chỉ hiện khi chọn OLED 2:1) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOledContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="visible"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:id="@+id/tvOledCardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Chế độ giả lập OLED (ESP32-C3)"
                        android:textColor="@color/colorAccentCyan"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvOledBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="128x64 (2:1)"
                        android:textColor="#00E5FF"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_icon_tint"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <!-- Thanh chọn 3 chế độ giả lập trực quan cho OLED (Status, HUD, Map) -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleOledMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOledStatus"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Đồng hồ Status"
                        android:textSize="11sp"
                        android:textColor="#F1F5F9"
                        app:icon="@drawable/ic_clock"
                        app:iconSize="14dp"
                        app:iconTint="@color/colorAccentCyan" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOledHud"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Chỉ dẫn HUD"
                        android:textSize="11sp"
                        android:textColor="#F1F5F9"
                        app:icon="@drawable/ic_navigation_arrow"
                        app:iconSize="14dp"
                        app:iconTint="@color/colorAccentCyan" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOledMap"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Bản đồ 128x64"
                        android:textSize="11sp"
                        android:textColor="#F1F5F9"
                        app:icon="@drawable/ic_map"
                        app:iconSize="14dp"
                        app:iconTint="@color/colorAccentCyan" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Thanh chọn 3 kiểu Bản đồ OLED (M1 Thuần Map, Chỉ Map Pure, M2 Chia đôi) -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleOledMapStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOledMapM1"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="M1: Thuần Map"
                        android:textSize="10.5sp"
                        android:textColor="#F1F5F9"
                        app:icon="@drawable/ic_navigation_arrow"
                        app:iconSize="12dp"
                        app:iconTint="@color/colorAccentCyan" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOledMapPure"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Chỉ có Map"
                        android:textSize="10.5sp"
                        android:textColor="#F1F5F9"
                        app:icon="@drawable/ic_map"
                        app:iconSize="12dp"
                        app:iconTint="#34D399" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOledMapM2"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="M2: Chia đôi"
                        android:textSize="10.5sp"
                        android:textColor="#F1F5F9"
                        app:icon="@drawable/ic_clock"
                        app:iconSize="12dp"
                        app:iconTint="#F59E0B" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <!-- Dòng giải thích mô tả chế độ đang mô phỏng -->
                <TextView
                    android:id="@+id/tvOledModeDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Đồng hồ Status: Giả lập màn hình chờ xe máy với đồng hồ số lớn, điện áp ắc quy, thanh đo tốc độ KM/H."
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:gravity="center" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Prepared BLE Packet Data -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gói tin BLE đang truyền (CHA_NAV)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tvBlePacketData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_terminal_box"
                    android:padding="14dp"
                    android:text="Chưa có gói dữ liệu nào được kết xuất..."
                    android:textColor="#00FF66"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Testing Controls -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bộ công cụ kiểm thử nhanh"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendCurrentMap"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Chụp &amp; Render giả lập"
                        app:icon="@drawable/ic_map"
                        app:iconTint="#FFFFFF"
                        android:textColor="#FFFFFF"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendDemoNav"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Gửi test chỉ đường"
                        app:icon="@drawable/ic_play"
                        app:iconTint="#FFFFFF"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearRenderLogs"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Xóa lịch sử log"
                    android:textColor="#FF4444"
                    app:iconTint="#FF4444"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- BLE Logs Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lịch sử dữ liệu đã gửi (Logs)"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <!-- Controls: Tạm dừng cuộn, Xóa log -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPauseRenderLog"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Tạm dừng cuộn"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_stop"
                        app:iconTint="#FFFFFF"
                        android:textColor="#FFFFFF"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClearRenderLogsTab"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Xóa nhật ký"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_delete"
                        app:iconTint="#FFFFFF"
                        android:textColor="#FFFFFF"/>
                </LinearLayout>

                <!-- Search Input -->
                <EditText
                    android:id="@+id/etSearchRenderLog"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_glass_search"
                    android:hint="Tìm kiếm nhật ký..."
                    android:textColorHint="#64748B"
                    android:textColor="#FFFFFF"
                    android:paddingHorizontal="14dp"
                    android:textSize="13sp"
                    android:layout_marginBottom="10dp"
                    android:drawableStart="@drawable/ic_search"
                    android:drawableTint="#38BDF8"
                    android:drawablePadding="10dp"
                    android:singleLine="true"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRenderLogs"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:nestedScrollingEnabled="false"
                    android:background="@drawable/bg_terminal_box"
                    android:padding="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
