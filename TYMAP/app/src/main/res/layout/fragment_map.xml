<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackgroundDeep">

    <!-- Search Bar & Map View -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_anchor="@+id/mapView"
        app:layout_anchorGravity="center" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/searchCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_map"
                app:tint="@color/colorAccentCyan" />

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_here"
                android:textColorHint="#94A3B8"
                android:textColor="@android:color/white"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:paddingHorizontal="12dp" />

            <ProgressBar
                android:id="@+id/searchProgress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_share"
                app:tint="@color/colorAccentCyan"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Search Suggestions -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/suggestionsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="72dp"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="18dp"
        app:cardElevation="10dp"
        app:strokeWidth="0dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSuggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card"
            android:maxHeight="300dp" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Floating Buttons Stack (Right) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="16dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/btnCompass"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_circle_button"
            android:elevation="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_compass"
            android:visibility="gone" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_my_location"
            app:backgroundTint="#D91E293B"
            app:fabSize="mini"
            app:tint="@color/colorAccentCyan" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabLayers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_layers"
            app:backgroundTint="#D91E293B"
            app:fabSize="mini"
            app:tint="@android:color/white" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabDisplayMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_speedometer"
            app:backgroundTint="#D91E293B"
            app:fabSize="mini"
            app:tint="@color/colorAccentPurple" />
    </LinearLayout>

    <!-- Bottom Sheet Navigation -->
    <include
        android:id="@+id/bottomSheet"
        layout="@layout/bottom_sheet_navigation" />

    <!-- Zoom Controls (Bottom Right) -->
    <LinearLayout
        android:id="@+id/zoomControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="12dp"
        app:layout_anchor="@id/bottomSheet"
        app:layout_anchorGravity="top|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabZoomIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:src="@drawable/ic_add"
            app:backgroundTint="#D91E293B"
            app:fabSize="mini"
            app:tint="@android:color/white" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabZoomOut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_remove"
            app:backgroundTint="#D91E293B"
            app:fabSize="mini"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Recenter Button (Center Bottom) -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/btnRecenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="12dp"
        android:layout_marginBottom="16dp"
        android:text="@string/recenter"
        android:textColor="@android:color/white"
        android:visibility="gone"
        app:backgroundTint="@color/colorAccentCyan"
        app:icon="@drawable/ic_my_location"
        app:iconTint="@android:color/white"
        app:layout_anchor="@id/bottomSheet"
        app:layout_anchorGravity="top|center_horizontal" />

    <!-- GPS Speedometer Badge (Bottom Left Overlay) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardGpsSpeedometer"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:elevation="12dp"
        app:layout_anchor="@id/bottomSheet"
        app:layout_anchorGravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="32dp"
        app:cardBackgroundColor="#D91E293B"
        app:strokeColor="#4438BDF8"
        app:strokeWidth="1.5dp"
        app:cardElevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGpsSpeedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@color/colorAccentCyan"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="km/h"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Speed Warning -->
    <ImageView
        android:id="@+id/ivSpeedWarning"
        android:layout_width="48dp"
        android:layout_height="73dp"
        android:elevation="12dp"
        android:layout_marginStart="90dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/ic_speedometer"
        android:visibility="gone"
        app:layout_anchor="@id/bottomSheet"
        app:layout_anchorGravity="top|start"
        app:tint="@android:color/holo_red_dark" />

    <!-- Full-screen Route Steps View -->
    <LinearLayout
        android:id="@+id/layoutRouteSteps"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/colorBackgroundDeep"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D9131B2E"
            android:padding="16dp">

            <ImageButton
                android:id="@+id/btnCloseSteps"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#FFFFFF" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStepsDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStepsSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Steps List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRouteSteps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
