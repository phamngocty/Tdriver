<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:padding="4dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="#94A3B8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Tùy biến Theme Studio"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnUploadTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Nạp BLE"
                android:textColor="#00E5FF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Category Tabs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tabStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_active"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="STATUS"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabNotif"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="NOTIF"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabMap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="MAP HUD"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Models Preset Scroll -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutPresets"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="Mặt đồng hồ giả lập (Chạm chọn để kéo thả):"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- 240x240 Circular GC9A01 Simulator Workspace -->
        <FrameLayout
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_circle_canvas">

            <RelativeLayout
                android:id="@+id/esp32Canvas"
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:clipChildren="true"
                android:clipToPadding="true">

                <!-- Brand Logo -->
                <TextView
                    android:id="@+id/wBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="105dp"
                    android:layout_marginTop="30dp"
                    android:text="TYMAP"
                    android:textColor="#475569"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <!-- Time -->
                <TextView
                    android:id="@+id/wTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="80dp"
                    android:layout_marginTop="60dp"
                    android:fontFamily="monospace"
                    android:text="10:45"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <!-- Date -->
                <TextView
                    android:id="@+id/wDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="70dp"
                    android:layout_marginTop="105dp"
                    android:text="Thứ năm, 13 thg 8"
                    android:textColor="#94A3B8"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Speed -->
                <TextView
                    android:id="@+id/wSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="90dp"
                    android:layout_marginTop="150dp"
                    android:fontFamily="monospace"
                    android:text="42 km/h"
                    android:textColor="@color/colorAccentGreen"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Phone Battery -->
                <TextView
                    android:id="@+id/wBatPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="45dp"
                    android:layout_marginTop="195dp"
                    android:background="#66000000"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="📱 85%"
                    android:textColor="@color/colorAccentCyan"
                    android:textSize="11sp" />

                <!-- Bike Battery -->
                <TextView
                    android:id="@+id/wBatBike"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="145dp"
                    android:layout_marginTop="195dp"
                    android:background="#66000000"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="2dp"
                    android:text="🔋 90%"
                    android:textColor="#F59E0B"
                    android:textSize="11sp" />

                <!-- Nav Arrow & Dist -->
                <LinearLayout
                    android:id="@+id/wNav"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="100dp"
                    android:layout_marginTop="190dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="➔"
                        android:textColor="@color/colorAccentCyan"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="150m"
                        android:textColor="@color/colorAccentGreen"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Notif Icon -->
                <TextView
                    android:id="@+id/wNotifIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="110dp"
                    android:layout_marginTop="50dp"
                    android:text="💬"
                    android:textSize="24sp"
                    android:visibility="gone" />

                <!-- Notif Title -->
                <TextView
                    android:id="@+id/wNotifTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="80dp"
                    android:layout_marginTop="95dp"
                    android:text="Nguyễn Văn A"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Notif Body -->
                <TextView
                    android:id="@+id/wNotifBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="40dp"
                    android:layout_marginTop="130dp"
                    android:maxWidth="160dp"
                    android:text="Alo chiều nay có chạy xe không?"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:visibility="gone" />

            </RelativeLayout>
        </FrameLayout>

        <!-- Custom Add buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAddMarquee"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="+ Thêm chữ cuộn"
                android:textColor="#8B5CF6"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnAddStatic"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="+ Thêm nhãn tĩnh"
                android:textColor="#8B5CF6"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Editor Controls Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvEditTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cấu hình: Đồng hồ"
                android:textColor="@color/colorAccentCyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- X and Y Input -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tọa độ X (Ngang)"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etCoordX"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_dark"
                        android:gravity="center"
                        android:inputType="number"
                        android:padding="6dp"
                        android:text="120"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <Space
                    android:layout_width="12dp"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tọa độ Y (Dọc)"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />

                    <EditText
                        android:id="@+id/etCoordY"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_dark"
                        android:gravity="center"
                        android:inputType="number"
                        android:padding="6dp"
                        android:text="75"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Align buttons -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Căn lề (Alignment)"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAlignLeft"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:text="Trái"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnAlignCenter"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:text="Căn Giữa"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnAlignRight"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:padding="0dp"
                    android:text="Phải"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Color choices -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Màu sắc hiển thị"
                android:textColor="#94A3B8"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/layoutColorPicker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal" />

        </LinearLayout>

        <!-- Widgets Checklist Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_dark"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Danh sách linh kiện hiển thị"
                android:textColor="@color/colorAccentCyan"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/containerChecklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Big Upload Button -->
        <Button
            android:id="@+id/btnBigUpload"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_tab_active"
            android:text="📲 NẠP LÊN ĐỒNG HỒ"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
